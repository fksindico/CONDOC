{
  "name": "condc-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CONDC — Sistema de Gestão de Documentos Normativos Condominiais",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run --workspace=apps/web dev",
    "build:web": "npm run --workspace=apps/web build",
    "build:contracts": "npm run --workspace=packages/api-contracts build",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspaces --if-present test"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
