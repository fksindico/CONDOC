# ==========================================
# CONFIGURAÇÕES DE ACESSO GITHUB
# ==========================================

# Token de Acesso Pessoal (PAT) do GitHub:
# Crie em: https://github.com/settings/tokens
# Permissões mínimas recomendadas (Classic): 'repo' (Full control of private repositories)
# Ou Fine-grained PAT com permissões de Leitura e Escrita em Conteúdo e Pull Requests.
GITHUB_TOKEN=ghp_seu_token_aqui

# Usuário ou Organização proprietária do repositório no GitHub
GITHUB_USERNAME=seu_usuario_github

# Nome do repositório no GitHub (ex: condoc ou CONDOC)
GITHUB_REPO=CONDOC

# URL remota completa do repositório (opcional, pode ser montada via https com token)
# Formato HTTPS autenticado: https://${GITHUB_TOKEN}@github.com/${GITHUB_USERNAME}/${GITHUB_REPO}.git
GITHUB_REMOTE_URL=https://github.com/seu_usuario_github/CONDOC.git

# Identificação para commits Git locais (opcional)
GIT_COMMITTER_NAME="Agente CONDOC"
GIT_COMMITTER_EMAIL="agente@condoc.local"

# ==========================================
# ACESSO SSH: LXC 1 — APLICAÇÃO CONDC
# (Frontend React, Core Django API, Celery, Redis, Proxy Reverso)
# ==========================================
LXC_APP_HOST=192.168.x.x
LXC_APP_PORT=22
LXC_APP_USER=root
LXC_APP_PASSWORD=sua_senha_aqui
# Caminho da chave privada SSH (opcional, se não usar senha):
# LXC_APP_SSH_KEY=~/.ssh/id_rsa

# ==========================================
# ACESSO SSH: LXC 2 — SUPABASE LOCAL STACK
# (PostgreSQL, Supabase Auth, Storage, Kong Gateway)
# ==========================================
LXC_SUPABASE_HOST=192.168.x.y
LXC_SUPABASE_PORT=22
LXC_SUPABASE_USER=root
LXC_SUPABASE_PASSWORD=sua_senha_aqui
# Caminho da chave privada SSH (opcional, se não usar senha):
# LXC_SUPABASE_SSH_KEY=~/.ssh/id_rsa

